@using TP6_FrontEnd.Services
@inject IAuthService AuthService
@inject ICarritoService CarritoService
@inject NavigationManager NavManager
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">TP6 FrontEnd</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <!-- Inicio -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

        <!-- Catálogo de Productos -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="catalogo">
                <span class="bi bi-grid-fill-nav-menu" aria-hidden="true"></span> Catálogo
            </NavLink>
        </div>

        <!-- Carrito de Compras con badge dinámico -->
        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center justify-content-between" href="carrito">
                <span>
                    <span class="bi bi-cart-fill-nav-menu" aria-hidden="true"></span> Carrito
                </span>
                @if (cantidadItemsCarrito > 0)
                {
                    <span class="badge bg-danger rounded-pill">@cantidadItemsCarrito</span>
                }
            </NavLink>
        </div>

        @if (estaAutenticado && rolUsuario == "Administrador")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/productos">
                    <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Panel Admin
                </NavLink>
            </div>
        }

        <hr class="text-white-50 mx-3 my-2" />

        <!-- Sección de Autenticación / Sesión -->
        @if (!estaAutenticado)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-box-arrow-in-right-nav-menu" aria-hidden="true"></span> Iniciar Sesión
                </NavLink>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <div class="text-white-50 small px-3 py-1">
                    Sesión: <strong class="text-white">@rolUsuario</strong>
                </div>
            </div>
            <div class="nav-item px-3">
                <button class="nav-link btn btn-link text-start w-100" @onclick="CerrarSesion">
                    <span class="bi bi-box-arrow-left-nav-menu" aria-hidden="true"></span> Cerrar Sesión
                </button>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool estaAutenticado = false;
    private string? rolUsuario;
    private int cantidadItemsCarrito = 0;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    protected override async Task OnInitializedAsync()
    {
        await ActualizarEstadoAuth();
        ActualizarContadorCarrito();

        // Escucha cambios del carrito en memoria para redibujar el badge
        CarritoService.OnCarritoCambiado += ManejarCambioCarrito;

        // Escucha cambios de URL para refrescar la barra cuando cambia de página
        NavManager.LocationChanged += ManejarCambioUbicacion;
    }

    private async Task ActualizarEstadoAuth()
    {
        estaAutenticado = await AuthService.EstaAutenticadoAsync();
        if (estaAutenticado)
        {
            rolUsuario = await AuthService.ObtenerRolAsync();
        }
        else
        {
            rolUsuario = null;
        }
    }

    private void ActualizarContadorCarrito()
    {
        cantidadItemsCarrito = CarritoService.ObtenerItems().Sum(i => i.Cantidad);
    }

    private void ManejarCambioCarrito()
    {
        ActualizarContadorCarrito();
        InvokeAsync(StateHasChanged);
    }

    private async void ManejarCambioUbicacion(object? sender, LocationChangedEventArgs e)
    {
        await ActualizarEstadoAuth();
        ActualizarContadorCarrito();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CerrarSesion()
    {
        await AuthService.LogoutAsync();
        estaAutenticado = false;
        rolUsuario = null;
        NavManager.NavigateTo("/login");
    }

    public void Dispose()
    {
        CarritoService.OnCarritoCambiado -= ManejarCambioCarrito;
        NavManager.LocationChanged -= ManejarCambioUbicacion;
    }
}