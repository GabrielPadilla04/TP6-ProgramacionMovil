@page "/producto/{Id:int}"
@using TP6_Shared.DTOs.Producto.Response
@using TP6_FrontEnd.Services
@inject IProductoService ProductoService
@inject ICarritoService CarritoService
@inject NavigationManager NavManager
@inject HttpClient Http

<div class="container py-4">
    <button class="btn btn-outline-secondary mb-4 rounded-3" @onclick='() => NavManager.NavigateTo("/catalogo")'>
        <i class="bi bi-arrow-left me-1"></i> Volver al Catálogo
    </button>

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Cargando información del producto...</p>
        </div>
    }
    else if (producto == null)
    {
        <div class="alert alert-warning text-center">
            No se encontró el producto solicitado.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden p-4">
            <div class="row g-4 align-items-center">
                <div class="col-12 col-md-6 text-center">
                    <img src="@ResolverUrlImagen(producto.ImagenUrl)"
                         alt="@producto.Nombre"
                         class="img-fluid rounded-4 shadow-sm"
                         style="max-height: 400px; width: 100%; object-fit: contain; background: #f8fafc;"
                         @onerror='() => producto.ImagenUrl = "https://placehold.co/500x400?text=Sin+Imagen"' />
                </div>
                <div class="col-12 col-md-6">
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill mb-2">
                        @(producto.CategoriaNombre ?? "Sin Categoría")
                    </span>
                    <h2 class="fw-bold mb-2">@producto.Nombre</h2>
                    <p class="text-muted small mb-3">Código de producto: #@producto.Id</p>

                    <h3 class="text-primary fw-bolder mb-3">$@producto.Precio.ToString("N2")</h3>

                    <div class="mb-4">
                        <h6 class="fw-semibold">Descripción:</h6>
                        <p class="text-secondary">@(string.IsNullOrWhiteSpace(producto.Descripcion) ? "Sin descripción detallada." : producto.Descripcion)</p>
                    </div>

                    <div class="d-flex align-items-center gap-3 mb-4">
                        @if (producto.Stock > 0)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                                <i class="bi bi-check-circle me-1"></i> Stock disponible: @producto.Stock
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill">
                                <i class="bi bi-x-circle me-1"></i> Sin Stock
                            </span>
                        }
                    </div>

                    <button class="btn btn-primary btn-lg rounded-3 w-100 py-3 fw-bold"
                            disabled="@(producto.Stock <= 0)"
                            @onclick="AgregarAlCarrito">
                        <i class="bi bi-cart-plus me-2"></i> Añadir al Carrito
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private ProductoResponse? producto;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            producto = await ProductoService.ObtenerPorIdAsync(Id);
        }
        catch (Exception)
        {
            producto = null;
        }
        finally
        {
            cargando = false;
        }
    }

    private void AgregarAlCarrito()
    {
        if (producto != null)
        {
            CarritoService.AgregarProducto(producto.Id, producto.Nombre, producto.Precio, producto.Stock, producto.ImagenUrl);
            NavManager.NavigateTo("/carrito");
        }
    }

    private string ResolverUrlImagen(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return "https://placehold.co/500x400?text=Sin+Imagen";
        }

        if (url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            url.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            url.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
        {
            return url;
        }

        var baseAddress = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
        return $"{baseAddress}/{url.TrimStart('/')}";
    }
}