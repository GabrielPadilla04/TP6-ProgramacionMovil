@page "/registro"
@layout Layout.LoginLayout
@using System.ComponentModel.DataAnnotations
@using TP6_Shared.DTOs.Auth
@using TP6_Shared.DTOs.Proveedor.Request 
@using TP6_FrontEnd.Services
@inject NavigationManager NavManager
@inject IAuthService AuthService

<div class="card shadow-sm mx-auto" style="width: 100%; max-width: 500px;">
    <div class="card-body p-4">
        <div class="text-center mb-4">
            <h3 class="card-title fw-bold">Crear Cuenta</h3>
            <p class="text-muted">Completá tus datos para registrarte</p>
        </div>

        <EditForm Model="@registroModel" OnValidSubmit="ProcesarRegistro">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="alert alert-danger py-2 text-center" role="alert">
                    @mensajeError
                </div>
            }

            <!-- Switch para Proveedor -->
            <div class="form-check form-switch mb-4 p-3 bg-light rounded border">
                <input class="form-check-input ms-0 me-2" type="checkbox" role="switch" id="esProveedor" @bind="registroModel.EsProveedor" />
                <label class="form-check-label fw-bold text-primary" for="esProveedor" style="cursor:pointer;">Quiero registrarme como Proveedor</label>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Nombre completo</label>
                <InputText class="form-control" @bind-Value="registroModel.Nombre" placeholder="Ej: Valentín Montes" />
                <ValidationMessage For="@(() => registroModel.Nombre)" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Email</label>
                <InputText type="email" class="form-control" @bind-Value="registroModel.Email" placeholder="correo@ejemplo.com" />
                <ValidationMessage For="@(() => registroModel.Email)" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Contraseña</label>
                <InputText type="password" class="form-control" @bind-Value="registroModel.Password" placeholder="******" />
                <ValidationMessage For="@(() => registroModel.Password)" class="text-danger small" />
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Confirmar Contraseña</label>
                <InputText type="password" class="form-control" @bind-Value="registroModel.ConfirmarPassword" placeholder="******" />
                <ValidationMessage For="@(() => registroModel.ConfirmarPassword)" class="text-danger small" />
            </div>

            @if (registroModel.EsProveedor)
            {
                <hr class="text-muted" />
                <h6 class="fw-bold text-primary mb-3"><i class="bi bi-shop me-1"></i> Datos Comerciales</h6>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Razón Social</label>
                    <InputText class="form-control" @bind-Value="registroModel.RazonSocial" placeholder="Ej: Distribuidora SRL" />
                    <ValidationMessage For="@(() => registroModel.RazonSocial)" class="text-danger small" />
                </div>

                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <label class="form-label fw-semibold">CUIT</label>
                        <InputText class="form-control" @bind-Value="registroModel.Cuit" placeholder="30-12345678-9" />
                        <ValidationMessage For="@(() => registroModel.Cuit)" class="text-danger small" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold">Teléfono</label>
                        <InputText class="form-control" @bind-Value="registroModel.Telefono" placeholder="2954-123456" />
                    </div>
                </div>
            }

            <button type="submit" class="btn btn-primary w-100 py-2 mb-3" disabled="@cargando">
                @if (cargando)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    <span>Procesando...</span>
                }
                else
                {
                    <span>Registrarme</span>
                }
            </button>

            <div class="text-center mt-3">
                <span class="text-muted">¿Ya tenés cuenta?</span>
                <a href="/login" class="text-decoration-none fw-bold ms-1">Iniciá sesión acá</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private RegistroViewModel registroModel = new();
    private bool cargando = false;
    private string? mensajeError;

    private async Task ProcesarRegistro()
    {
        if (registroModel.EsProveedor)
        {
            if (string.IsNullOrWhiteSpace(registroModel.RazonSocial) || string.IsNullOrWhiteSpace(registroModel.Cuit))
            {
                mensajeError = "La Razón Social y el CUIT son obligatorios para ser Proveedor.";
                return;
            }
        }

        cargando = true;
        mensajeError = null;
        bool exito = false;

        try
        {
            if (registroModel.EsProveedor)
            {
                // Acá usamos tu DTO CrearProveedorRequest
                var dtoProveedor = new CrearProveedorRequest
                {
                    NombreCompleto = registroModel.Nombre,
                    Email = registroModel.Email,
                    Password = registroModel.Password,
                    RazonSocial = registroModel.RazonSocial,
                    Cuit = registroModel.Cuit,
                    Telefono = registroModel.Telefono
                };

                exito = await AuthService.RegistrarProveedorAsync(dtoProveedor);
            }
            else
            {
                var dtoCliente = new RegisterDto
                {
                    NombreCompleto = registroModel.Nombre,
                    Email = registroModel.Email,
                    Password = registroModel.Password,
                    Rol = "Usuario"
                };

                exito = await AuthService.RegistrarAsync(dtoCliente);
            }

            if (exito)
            {
                NavManager.NavigateTo("/login");
            }
            else
            {
                mensajeError = "Ocurrió un error al registrarte. Es posible que el email o CUIT ya existan.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error del sistema: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    public class RegistroViewModel
    {
        public bool EsProveedor { get; set; }

        [Required(ErrorMessage = "El nombre es obligatorio")]
        public string Nombre { get; set; } = string.Empty;

        [Required(ErrorMessage = "El email es obligatorio")]
        [EmailAddress(ErrorMessage = "Email inválido")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria")]
        [MinLength(6, ErrorMessage = "Mínimo 6 caracteres")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Requerido")]
        [Compare(nameof(Password), ErrorMessage = "Las contraseñas no coinciden")]
        public string ConfirmarPassword { get; set; } = string.Empty;

        public string RazonSocial { get; set; } = string.Empty;
        public string Cuit { get; set; } = string.Empty;
        public string Telefono { get; set; } = string.Empty;
    }
}