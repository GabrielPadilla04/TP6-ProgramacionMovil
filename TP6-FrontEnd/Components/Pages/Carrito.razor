@page "/carrito"
@using TP6_Shared.DTOs
@using TP6_FrontEnd.Models
@using TP6_FrontEnd.Services
@inject ICarritoService CarritoService
@inject IVentaService VentaService
@inject IAuthService AuthService
@inject NavigationManager NavManager

<div class="container mt-4 mb-5">
    <h2 class="mb-4">Mi Carrito de Compras</h2>

    @if (!string.IsNullOrWhiteSpace(mensajeAlerta))
    {
        <div class="alert @claseAlerta alert-dismissible fade show" role="alert">
            @mensajeAlerta
            <button type="button" class="btn-close" @onclick="() => mensajeAlerta = null"></button>
        </div>
    }

    @if (!items.Any())
    {
        <div class="card p-5 text-center shadow-sm border-0">
            <div class="mb-3">
                <span class="bi bi-cart-x fs-1 text-muted"></span>
            </div>
            <h4>El carrito está vacío</h4>
            <p class="text-muted">Explorá nuestro catálogo para agregar productos.</p>
            <div class="mt-3">
                <a href="catalogo" class="btn btn-primary">Ir al Catálogo</a>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12 col-lg-8">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th>Precio</th>
                                    <th style="width: 140px;">Cantidad</th>
                                    <th>Subtotal</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in items)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@item.Nombre</div>
                                        </td>
                                        <td>$@item.Precio</td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <button class="btn btn-outline-secondary" @onclick="() => ModificarCantidad(item.ProductoId, item.Cantidad - 1)">-</button>
                                                <span class="input-group-text px-3 bg-white">@item.Cantidad</span>
                                                <button class="btn btn-outline-secondary" @onclick="() => ModificarCantidad(item.ProductoId, item.Cantidad + 1)">+</button>
                                            </div>
                                        </td>
                                        <td class="fw-bold">$@item.Subtotal</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarItem(item.ProductoId)">
                                                <span class="bi bi-trash"></span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Resumen y Checkout -->
            <div class="col-12 col-lg-4">
                <div class="card shadow-sm border-0 p-3">
                    <h5 class="card-title mb-3">Resumen de Compra</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Productos (@items.Sum(i => i.Cantidad))</span>
                        <span>$@TotalCompra</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-3 fw-bold fs-5">
                        <span>Total</span>
                        <span>$@TotalCompra</span>
                    </div>

                    <button class="btn btn-success w-100 py-2" @onclick="ConfirmarCompra" disabled="@procesandoCompra">
                        @if (procesandoCompra)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Procesando...</span>
                        }
                        else
                        {
                            <span>Finalizar Compra</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ItemCarrito> items = new();
    private bool procesandoCompra = false;
    private string? mensajeAlerta;
    private string claseAlerta = "alert-success";

    private decimal TotalCompra => items.Sum(i => i.Subtotal);

    protected override void OnInitialized()
    {
        items = CarritoService.ObtenerItems();
    }

    private void ModificarCantidad(int productoId, int nuevaCantidad)
    {
        if (nuevaCantidad <= 0)
        {
            CarritoService.EliminarItem(productoId);
        }
        else
        {
            CarritoService.ActualizarCantidad(productoId, nuevaCantidad);
        }
        items = CarritoService.ObtenerItems();
    }

    private void EliminarItem(int productoId)
    {
        CarritoService.EliminarItem(productoId);
        items = CarritoService.ObtenerItems();
    }

    private async Task ConfirmarCompra()
    {
        procesandoCompra = true;
        mensajeAlerta = null;

        if (!await AuthService.EstaAutenticadoAsync())
        {
            NavManager.NavigateTo("/login");
            procesandoCompra = false;
            return;
        }

        var usuarioId = await AuthService.ObtenerUsuarioIdAsync();
        if (usuarioId == null)
        {
            mensajeAlerta = "No se pudo recuperar la identidad del usuario. Reingresá.";
            claseAlerta = "alert-danger";
            procesandoCompra = false;
            return;
        }

        var detalles = items.Select(i => new ItemSalidaDto
        {
            ProductoId = i.ProductoId,
            Cantidad = i.Cantidad,
            PrecioVenta = i.Precio
        }).ToList();

        var request = new RegistrarSalidaDto
        {
            UsuarioId = usuarioId.Value,
            ClienteId = 1,
            Detalles = detalles
        };

        var exito = await VentaService.RegistrarSalidaAsync(request);

        if (exito)
        {
            CarritoService.VaciarCarrito();
            items = CarritoService.ObtenerItems();
            mensajeAlerta = "¡Compra registrada con éxito! Tu orden ha sido procesada.";
            claseAlerta = "alert-success";
        }
        else
        {
            mensajeAlerta = "Ocurrió un error al procesar la salida en el servidor.";
            claseAlerta = "alert-danger";
        }

        procesandoCompra = false;
    }
}